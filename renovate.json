{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "* 6 * * *"
        ],
        "automerge": true,
        "automergeStrategy": "rebase"
    },
    "packageRules": [
        {
            "matchFileNames": [
                "renovate.json"
            ],
            "groupName": "renovate configuration",
            "automerge": true
        },
        {
            "matchFileNames": [
                "mise/config.toml"
            ],
            "matchManagers": [
                "mise"
            ],
            "groupName": "mise tools",
            "separateMajorMinor": false
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "GitHub Actions manifest",
            "automerge": true
        }
    ],
    "timezone": "Asia/Tokyo",
    "dependencyDashboard": true
}
